[fetch]
    prune = true
[user]
	name = parbez
	email = imranbarbhuiya.fsd@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBaQ+xwO+1Dj22nk8BtTS2O42rLc96Ul0AH7xJhWqDhC
[commit]
	gpgsign = true
[tag]
	sort = version:refname
	forceSignAnnotated = true
[init]
	defaultBranch = main
[core]
	editor = cursor --wait
	autocrlf = false
	ignorecase = false
	symlinks = true
	excludesfile = ~/.gitignore
[alias]
    alias = !git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
    br-delete-useless = "!f() { current=$(git branch --show-current); git branch --merged main --format='%(refname:short)' | while IFS= read -r branch; do if [ \"$branch\" != \"main\" ] && [ \"$branch\" != \"$current\" ]; then git branch -d \"$branch\"; fi; done; }; f"
    co = checkout
    undo = reset --soft HEAD^
    yolo = !git commit -m \"$(curl -s https://whatthecommit.com/index.txt)\"

[push]
    autoSetupRemote = true
    followTags = true
[pull]
	rebase = true
[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true
[rerere]
    enabled = true
[diff]
    algorithm = histogram
    colorMoved = default
[merge]
    conflictStyle = zdiff3
[branch]
    sort = -committerdate
[column]
    ui = auto
[status]
    short = true
    branch = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers
[url "git@github.com:"]
	insteadOf = https://github.com/
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
