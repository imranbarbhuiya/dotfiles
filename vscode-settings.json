{
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.suggest.insertMode": "replace",
  },
  "[python]": {
    "editor.formatOnType": true,
  },
  "debug.console.fontFamily": "Lilex, 'JetBrains Mono'",
  "diffEditor.experimental.showMoves": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.accessibilitySupport": "off",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'Monaspace Neon', 'JetBrains Mono', 'FiraCode Nerd Font'",
  "editor.fontLigatures": true,
  "editor.fontSize": 18,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.enabled": "on",
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.autohide": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.scale": 1,
  "emmet.excludeLanguages": [],
  "emmet.includeLanguages": {
    "markdown": "html",
  },
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".env.local": ".env.*",
    ".gitignore": ".gitattributes, .gitmodules",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts, ${capture}.mjs, ${capture}.global.js, ${capture}.test.js",
    "*.jsx": "${capture}.js",
    "*.mjs": "${capture}.mjs.map, ${capture}.min.mjs, ${capture}.d.mts",
    "*.schema.ts": "${capture}.model.ts, ${capture}.dto.ts",
    "*.ts": "${capture}.test.ts, ${capture}.js",
    "*.tsx": "${capture}.android.tsx, ${capture}.ios.tsx, ${capture}.ts, ${capture}.test.tsx, ${capture}.test.ts, ${capture}.module.css, ${capture}.css",
    "package.json": "package-lock.json, yarn.lock, .yarnrc.yml, pnpm-lock.yaml, bun.lock, turbo.json, tsconfig.json, tsconfig.*, jest.config.js, jest.config.cjs, jest.config.mjs, jest.config.ts, vitest.config.ts, vitest.config.js, vitest.config.cjs, vitest.config.mjs, vitest.workspace.ts, eslint.config.js, .prettier*, biome.json, oxc.json, postcss.config.js, components.json, .eslintcache, .gitignore",
    "Dockerfile": "docker-compose.yml, docker-compose.override.yml, .dockerignore, Jenkinsfile*",
  },
  "files.associations": {
    "*.html": "html",
    ".env": "shellscript",
  },
  "files.defaultLanguage": "${activeEditorLanguage}",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/node_modules/*/**": true,
    "**/target/**": true,
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableCommitSigning": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "never",
  "prettier.singleQuote": true,
  "remote.defaultExtensionsIfInstalledLocally": [
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
  ],
  "scm.inputFontFamily": "editor",
  "search.exclude": {
    "**/.next": true,
    "**/.yarn": true,
    "**/*.code-search": true,
    "**/node_modules": true,
    "**/yarn.lock": true,
  },
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.autoReplies": {
    "Terminate batch job (Y/N)": "Y\r",
  },
  "terminal.integrated.env.osx": {
    "CW_NEW_SESSION": "1",
    "Q_NEW_SESSION": "1",
  },
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font'",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.suggest.cdPath": "relative",
  "terminal.integrated.suggest.enabled": true,
  "js/ts.inlayHints.parameterNames.enabled": "all",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.updateImportsOnPaste.enabled": false,
  "window.newWindowDimensions": "maximized",
  "window.titleBarStyle": "custom",
  "workbench.activityBar.location": "bottom",
  "workbench.editor.customLabels.patterns": {
    "**/app/**/_layout.tsx": "${dirname} - Layout",
    "**/app/**/index.tsx": "${dirname} - Page",
    "**/app/**/layout.tsx": "${dirname} - Layout",
    "**/app/**/page.tsx": "${dirname} - Page",
    "**/app/**/route.tsx": "${dirname} - Route",
    "**/components/**/index.tsx": "${dirname} - Component",
  },
  "workbench.secondarySideBar.showLabels": false,
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "[yaml]": {
    "diffEditor.ignoreTrimWhitespace": true,
  },
  "js/ts.experimental.useTsgo": true,
  "workbench.panel.showLabels": false,
  "explorer.confirmPasteNative": false,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": false,
  "terminal.integrated.tabs.title": "${sequence}${separator}${process}",
  "cursor.cpp.disabledLanguages": ["plaintext"],
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "window.autoDetectColorScheme": true,
  "cursor.composer.codeBlockWordWrap": true,
  "workbench.editor.enablePreview": false,
}
